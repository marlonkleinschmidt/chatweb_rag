# Base URL of the backend API (served only on 127.0.0.1)
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
# Document list polling interval in milliseconds while a document is received/processing
VITE_POLL_INTERVAL_MS=2000
# Maximum documents selected per question; keep equal to MAX_DOCUMENTS_PER_QUERY in backend/.env
VITE_MAX_DOCUMENTS_PER_QUERY=10
# Maximum question length; keep equal to MAX_QUESTION_CHARS in backend/.env
VITE_MAX_QUESTION_CHARS=2000
# Previous question/answer pairs sent as conversation history (0 turns it off);
# keep equal to MAX_HISTORY_TURNS in backend/.env
VITE_MAX_HISTORY_TURNS=4
# Maximum characters of the history sent (sum of all messages); keep equal to MAX_HISTORY_CHARS
VITE_MAX_HISTORY_CHARS=4000
