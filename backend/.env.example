# Copy to backend/.env and fill in real values. Never commit .env.

# OpenAI (required from Sprint 3; the health endpoint starts without it)
OPENAI_API_KEY=your-openai-api-key-here
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
CHAT_TEMPERATURE=0
PROVIDER_TIMEOUT_S=60

# Upload limits
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=500

# RAG (validated in Sprint 3, see docs/eval.md)
CHUNK_SIZE=500
CHUNK_OVERLAP=200
RETRIEVAL_K=8
RELEVANCE_THRESHOLD=0.35

# Chat limits
MAX_QUESTION_CHARS=2000
MAX_DOCUMENTS_PER_QUERY=10
EXCERPT_MAX_CHARS=500

# Storage (relative paths resolve from the directory where uvicorn runs)
CHROMA_COLLECTION=documents
DOCUMENTS_DIR=data/documents
CHROMA_DIR=data/chroma
SQLITE_PATH=data/app.db

# Network (CORS_ORIGINS is a JSON list)
CORS_ORIGINS=["http://localhost:5173"]
API_HOST=127.0.0.1
